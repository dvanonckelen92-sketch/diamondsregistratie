---
import { actions } from 'astro:actions';
import Layout from '../layouts/Layout.astro';
import type { Profile } from '../lib/types';

interface Props {
  title: string;
  profile: Profile;
}

const { title, profile } = Astro.props;
const pathname = Astro.url.pathname;

const jufLinks = [
  { href: '/mijn-uren', label: 'Mijn uren' },
  { href: `/mijn-overzicht/${new Date().toISOString().slice(0, 7)}`, label: 'Mijn overzicht' }
];

const adminLinks = [
  { href: '/admin/overzicht', label: 'Overzicht' },
  { href: '/admin/juffen', label: 'Juffen' },
  { href: '/admin/categorieen', label: 'Categorieën' },
  { href: '/admin/export', label: 'Export' }
];

const links = profile.rol === 'admin' ? adminLinks : jufLinks;

function isActive(href: string) {
  return pathname === href || pathname.startsWith(href + '/');
}
---

<Layout title={title}>
  <div class="flex min-h-screen flex-col">
    <header class="border-b-2 border-brand-gold bg-white">
      <div class="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-3 px-4 py-3">
        <div class="flex items-center gap-3">
          <span class="text-lg font-bold uppercase tracking-wide text-brand-black">
            Dansschool <span class="text-brand-gold">Diamonds</span>
          </span>
          <span class="hidden text-sm text-slate-400 sm:inline">· Uurregistratie</span>
          <span class="rounded-full border border-brand-gold/40 bg-brand-gold-light px-2 py-0.5 text-xs font-medium text-brand-gold-dark"
            >{profile.rol === 'admin' ? 'Beheerder' : 'Juf'}</span
          >
        </div>
        <nav class="flex flex-wrap gap-1">
          {
            links.map((link) => (
              <a
                href={link.href}
                class:list={[
                  'rounded-md px-3 py-1.5 text-sm font-medium',
                  isActive(link.href) ? 'bg-brand-black text-white' : 'text-slate-600 hover:bg-brand-gold-light'
                ]}
              >
                {link.label}
              </a>
            ))
          }
        </nav>
        <div class="flex items-center gap-3">
          <span class="text-sm text-slate-500">{profile.naam}</span>
          <form method="POST" action={actions.auth.logout}>
            <button type="submit" class="text-sm font-medium text-slate-500 hover:text-brand-red">
              Uitloggen
            </button>
          </form>
        </div>
      </div>
    </header>
    <main class="mx-auto w-full max-w-5xl flex-1 px-4 py-6">
      <h1 class="mb-6 text-xl font-semibold">{title}</h1>
      <slot />
    </main>
  </div>
</Layout>
