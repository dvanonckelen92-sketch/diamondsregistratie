---
import { actions } from 'astro:actions';
import Layout from '../layouts/Layout.astro';

const result = Astro.getActionResult(actions.auth.login);
if (result && !result.error) {
  const next = new URL(Astro.request.url).searchParams.get('next');
  return Astro.redirect(next || '/mijn-uren');
}

const next = Astro.url.searchParams.get('next') ?? '';
---

<Layout title="Inloggen">
  <div class="flex min-h-screen items-center justify-center px-4">
    <div class="w-full max-w-sm rounded-lg border border-slate-200 bg-white p-6 shadow-sm">
      <h1 class="mb-1 text-xl font-semibold">Inloggen</h1>
      <p class="mb-6 text-sm text-slate-500">Uurregistratie dansschool</p>

      <form method="POST" action={actions.auth.login} class="flex flex-col gap-4">
        <input type="hidden" name="next" value={next} />
        <div>
          <label for="email" class="mb-1 block text-sm font-medium text-slate-700">E-mailadres</label>
          <input
            id="email"
            name="email"
            type="email"
            required
            autocomplete="email"
            class="w-full rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-slate-500 focus:outline-none"
          />
        </div>
        <div>
          <label for="wachtwoord" class="mb-1 block text-sm font-medium text-slate-700">Wachtwoord</label>
          <input
            id="wachtwoord"
            name="wachtwoord"
            type="password"
            required
            autocomplete="current-password"
            class="w-full rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-slate-500 focus:outline-none"
          />
        </div>

        {
          result?.error && (
            <p class="text-sm text-red-600">{result.error.message}</p>
          )
        }

        <button
          type="submit"
          class="mt-2 rounded-md bg-slate-900 px-4 py-2 text-sm font-medium text-white hover:bg-slate-800"
        >
          Inloggen
        </button>
      </form>

      <a href="/wachtwoord-vergeten" class="mt-4 block text-center text-sm text-slate-500 hover:text-slate-700">
        Wachtwoord vergeten?
      </a>
    </div>
  </div>
</Layout>
