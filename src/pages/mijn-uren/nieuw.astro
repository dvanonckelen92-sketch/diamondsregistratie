---
import { actions } from 'astro:actions';
import AppShell from '../../components/AppShell.astro';
import type { Category, HourEntry } from '../../lib/types';

const supabase = Astro.locals.supabase;
const profile = Astro.locals.profile!;

const [{ data: categories }, { data: rates }] = await Promise.all([
  supabase.from('categories').select('*').order('naam'),
  supabase.from('rates').select('category_id').eq('profile_id', profile.id)
]);

const editId = Astro.url.searchParams.get('id');
let entry: HourEntry | null = null;
if (editId) {
  const { data } = await supabase.from('hour_entries').select('*').eq('id', editId).single();
  entry = data;
}

const isEdit = !!entry;
const action = isEdit ? actions.hours.update : actions.hours.create;
const result = Astro.getActionResult(action);
if (result && !result.error) {
  return Astro.redirect('/mijn-uren');
}

// Enkel categorieën tonen waarvoor de admin al een tarief heeft ingesteld
// voor deze juf — anders kan ze uren ingeven die nergens meetellen. Bij het
// bewerken van een bestaande registratie blijft haar huidige categorie wel
// gewoon in de lijst staan, ook al zou het tarief er ondertussen af zijn.
const categorieenMetTarief = new Set((rates ?? []).map((r) => r.category_id));
const beschikbareCategorieen = (categories as Category[] | null ?? []).filter(
  (c) => categorieenMetTarief.has(c.id) || c.id === entry?.category_id
);

const vandaag = new Date().toISOString().slice(0, 10);
---

<AppShell title={isEdit ? 'Uren bewerken' : 'Uren toevoegen'} profile={profile}>
  {
    beschikbareCategorieen.length === 0 ? (
      <p class="max-w-md rounded-md border border-dashed border-slate-300 p-6 text-center text-sm text-slate-500">
        Er is nog geen tarief voor jou ingesteld. Vraag de beheerder om eerst een tarief te koppelen aan een
        categorie voor je uren kan ingeven.
      </p>
    ) : (
  <form method="POST" action={action} class="flex max-w-md flex-col gap-4">
    {isEdit && <input type="hidden" name="id" value={entry!.id} />}

    <div>
      <label for="datum" class="mb-1 block text-sm font-medium text-slate-700">Datum</label>
      <input
        id="datum"
        name="datum"
        type="date"
        required
        value={entry?.datum ?? vandaag}
        class="w-full rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-brand-gold focus:outline-none"
      />
    </div>

    <div>
      <label for="categoryId" class="mb-1 block text-sm font-medium text-slate-700">Categorie</label>
      <select
        id="categoryId"
        name="categoryId"
        required
        class="w-full rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-brand-gold focus:outline-none"
      >
        {beschikbareCategorieen.map((c) => (
          <option value={c.id} selected={c.id === entry?.category_id}>
            {c.naam}
          </option>
        ))}
      </select>
    </div>

    <div>
      <label for="aantalUren" class="mb-1 block text-sm font-medium text-slate-700">Aantal uren</label>
      <input
        id="aantalUren"
        name="aantalUren"
        type="number"
        step="0.25"
        min="0.25"
        required
        value={entry?.aantal_uren ?? ''}
        class="w-full rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-brand-gold focus:outline-none"
      />
    </div>

    <div>
      <label for="opmerking" class="mb-1 block text-sm font-medium text-slate-700">Opmerking (optioneel)</label>
      <textarea
        id="opmerking"
        name="opmerking"
        rows="2"
        class="w-full rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-brand-gold focus:outline-none"
        >{entry?.opmerking ?? ''}</textarea
      >
    </div>

    {result?.error && <p class="text-sm text-red-600">{result.error.message}</p>}

    <div class="flex gap-2">
      <button
        type="submit"
        class="rounded-md bg-brand-red px-4 py-2 text-sm font-medium text-white hover:bg-brand-red-dark"
      >
        Opslaan
      </button>
      <a
        href="/mijn-uren"
        class="rounded-md border border-slate-300 px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-100"
      >
        Annuleren
      </a>
    </div>
  </form>
    )
  }
</AppShell>
