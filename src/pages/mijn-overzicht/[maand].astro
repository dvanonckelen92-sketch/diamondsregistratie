---
import AppShell from '../../components/AppShell.astro';
import type { Category, ExtraPayment, HourEntryWithAmount } from '../../lib/types';
import { formatEuro, maandBereik } from '../../lib/format';

const supabase = Astro.locals.supabase;
const profile = Astro.locals.profile!;
const { maand } = Astro.params as { maand: string };

if (!/^\d{4}-\d{2}$/.test(maand)) {
  return Astro.redirect(`/mijn-overzicht/${new Date().toISOString().slice(0, 7)}`);
}

const { start, eind } = maandBereik(maand);

const [{ data: entries }, { data: extras }, { data: categories }] = await Promise.all([
  supabase
    .from('hour_entries_with_amount')
    .select('*')
    .eq('profile_id', profile.id)
    .gte('datum', start)
    .lt('datum', eind),
  supabase
    .from('extra_payments')
    .select('*')
    .eq('profile_id', profile.id)
    .gte('datum', start)
    .lt('datum', eind),
  supabase.from('categories').select('*').order('naam')
]);

const rows = (entries as HourEntryWithAmount[] | null) ?? [];
const extraRows = (extras as ExtraPayment[] | null) ?? [];
const categoryMap = new Map((categories as Category[] | null ?? []).map((c) => [c.id, c.naam]));

const totaalUren = rows.reduce((sum, r) => sum + Number(r.aantal_uren), 0);
const totaalLoon = rows.reduce((sum, r) => sum + Number(r.bedrag), 0);
const totaalExtra = extraRows.reduce((sum, r) => sum + Number(r.bedrag), 0);

const perCategorie = new Map<string, { uren: number; bedrag: number }>();
for (const r of rows) {
  const naam = categoryMap.get(r.category_id) ?? 'Onbekend';
  const huidig = perCategorie.get(naam) ?? { uren: 0, bedrag: 0 };
  huidig.uren += Number(r.aantal_uren);
  huidig.bedrag += Number(r.bedrag);
  perCategorie.set(naam, huidig);
}

function vorigeMaand(m: string) {
  const [j, mm] = m.split('-').map(Number);
  const d = new Date(Date.UTC(j, mm - 2, 1));
  return d.toISOString().slice(0, 7);
}
function volgendeMaand(m: string) {
  const [j, mm] = m.split('-').map(Number);
  const d = new Date(Date.UTC(j, mm, 1));
  return d.toISOString().slice(0, 7);
}
---

<AppShell title={`Mijn overzicht · ${maand}`} profile={profile}>
  <div class="mb-6 flex items-center justify-between">
    <a href={`/mijn-overzicht/${vorigeMaand(maand)}`} class="text-sm text-slate-500 hover:text-slate-900">
      ← Vorige maand
    </a>
    <a href={`/mijn-overzicht/${volgendeMaand(maand)}`} class="text-sm text-slate-500 hover:text-slate-900">
      Volgende maand →
    </a>
  </div>

  <div class="mb-6 grid grid-cols-1 gap-3 sm:grid-cols-3">
    <div class="rounded-lg border border-slate-200 bg-white p-4">
      <div class="text-xs text-slate-500">Totaal uren</div>
      <div class="text-2xl font-semibold">{totaalUren.toFixed(2)} u</div>
    </div>
    <div class="rounded-lg border border-slate-200 bg-white p-4">
      <div class="text-xs text-slate-500">Loon uit uren</div>
      <div class="text-2xl font-semibold">{formatEuro(totaalLoon)}</div>
    </div>
    <div class="rounded-lg border border-slate-200 bg-white p-4">
      <div class="text-xs text-slate-500">Extra vergoedingen</div>
      <div class="text-2xl font-semibold">{formatEuro(totaalExtra)}</div>
    </div>
  </div>

  <h2 class="mb-2 text-sm font-semibold text-slate-700">Per categorie</h2>
  {
    perCategorie.size === 0 ? (
      <p class="mb-6 text-sm text-slate-500">Geen registraties deze maand.</p>
    ) : (
      <div class="mb-6 overflow-x-auto rounded-lg border border-slate-200 bg-white">
        <table class="w-full text-sm">
          <thead class="bg-slate-50 text-left text-xs uppercase text-slate-500">
            <tr>
              <th class="px-3 py-2">Categorie</th>
              <th class="px-3 py-2">Uren</th>
              <th class="px-3 py-2">Bedrag</th>
            </tr>
          </thead>
          <tbody>
            {[...perCategorie.entries()].map(([naam, totaal]) => (
              <tr class="border-t border-slate-100">
                <td class="px-3 py-2">{naam}</td>
                <td class="px-3 py-2">{totaal.uren.toFixed(2)} u</td>
                <td class="px-3 py-2">{formatEuro(totaal.bedrag)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )
  }

  {
    extraRows.length > 0 && (
      <>
        <h2 class="mb-2 text-sm font-semibold text-slate-700">Extra vergoedingen</h2>
        <div class="overflow-x-auto rounded-lg border border-slate-200 bg-white">
          <table class="w-full text-sm">
            <thead class="bg-slate-50 text-left text-xs uppercase text-slate-500">
              <tr>
                <th class="px-3 py-2">Omschrijving</th>
                <th class="px-3 py-2">Datum</th>
                <th class="px-3 py-2">Bedrag</th>
              </tr>
            </thead>
            <tbody>
              {extraRows.map((e) => (
                <tr class="border-t border-slate-100">
                  <td class="px-3 py-2">{e.omschrijving}</td>
                  <td class="px-3 py-2">{e.datum}</td>
                  <td class="px-3 py-2">{formatEuro(Number(e.bedrag))}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </>
    )
  }
</AppShell>
