---
import { actions } from 'astro:actions';
import AppShell from '../../components/AppShell.astro';
import type { Category } from '../../lib/types';

const supabase = Astro.locals.supabase;
const profile = Astro.locals.profile!;

const { data: categories } = await supabase.from('categories').select('*').order('naam');

const createResult = Astro.getActionResult(actions.admin.createCategory);
const renameResult = Astro.getActionResult(actions.admin.renameCategory);
const deleteResult = Astro.getActionResult(actions.admin.deleteCategory);
const error = createResult?.error ?? renameResult?.error ?? deleteResult?.error;
---

<AppShell title="Categorieën" profile={profile}>
  <div class="mb-6 rounded-lg border border-slate-200 bg-white p-4">
    <h2 class="mb-3 text-sm font-semibold text-slate-700">Nieuwe categorie</h2>
    <form method="POST" action={actions.admin.createCategory} class="flex items-end gap-3">
      <div>
        <label for="naam" class="mb-1 block text-sm font-medium text-slate-700">Naam</label>
        <input
          id="naam"
          name="naam"
          type="text"
          required
          class="rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-brand-gold focus:outline-none"
        />
      </div>
      <button
        type="submit"
        class="rounded-md bg-brand-red px-4 py-2 text-sm font-medium text-white hover:bg-brand-red-dark"
      >
        Toevoegen
      </button>
    </form>
    {error && <p class="mt-2 text-sm text-red-600">{error.message}</p>}
  </div>

  <div class="overflow-x-auto rounded-lg border border-slate-200 bg-white">
    <table class="w-full text-sm">
      <thead class="bg-slate-50 text-left text-xs uppercase text-slate-500">
        <tr>
          <th class="px-3 py-2">Naam</th>
          <th class="px-3 py-2 text-right">Acties</th>
        </tr>
      </thead>
      <tbody>
        {
          ((categories as Category[] | null) ?? []).map((c) => (
            <tr class="border-t border-slate-100">
              <td class="px-3 py-2">
                <input
                  form={`rename-${c.id}`}
                  name="naam"
                  type="text"
                  value={c.naam}
                  class="w-full max-w-xs rounded-md border border-slate-300 px-2 py-1.5 text-sm focus:border-brand-gold focus:outline-none"
                />
              </td>
              <td class="px-3 py-2">
                <div class="flex justify-end gap-2">
                  <form id={`rename-${c.id}`} method="POST" action={actions.admin.renameCategory}>
                    <input type="hidden" name="id" value={c.id} />
                    <button
                      type="submit"
                      class="rounded-md border border-slate-300 px-2.5 py-1 text-xs font-medium text-slate-600 hover:border-brand-gold hover:text-brand-gold-dark"
                    >
                      Hernoemen
                    </button>
                  </form>
                  <form method="POST" action={actions.admin.deleteCategory}>
                    <input type="hidden" name="id" value={c.id} />
                    <button
                      type="submit"
                      class="rounded-md border border-red-200 px-2.5 py-1 text-xs font-medium text-red-600 hover:bg-red-50"
                    >
                      Verwijderen
                    </button>
                  </form>
                </div>
              </td>
            </tr>
          ))
        }
        {
          (!categories || categories.length === 0) && (
            <tr>
              <td colspan="2" class="px-3 py-6 text-center text-slate-500">
                Nog geen categorieën.
              </td>
            </tr>
          )
        }
      </tbody>
    </table>
  </div>
</AppShell>
