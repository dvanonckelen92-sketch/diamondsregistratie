---
import AppShell from '../../components/AppShell.astro';
import type { Profile } from '../../lib/types';
import { huidigeMaand } from '../../lib/format';

const supabase = Astro.locals.supabase;
const profile = Astro.locals.profile!;

const { data: juffen } = await supabase.from('profiles').select('*').eq('rol', 'juf').order('naam');
const maand = huidigeMaand();
---

<AppShell title="Export" profile={profile}>
  <form method="GET" action="/api/export" class="flex max-w-md flex-col gap-4 rounded-lg border border-slate-200 bg-white p-4">
    <div>
      <label for="maand" class="mb-1 block text-sm font-medium text-slate-700">Maand</label>
      <input
        id="maand"
        name="maand"
        type="month"
        value={maand}
        class="w-full rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-brand-gold focus:outline-none"
      />
      <p class="mt-1 text-xs text-slate-500">Leeg laten voor alle maanden.</p>
    </div>

    <div>
      <label for="jufId" class="mb-1 block text-sm font-medium text-slate-700">Juf</label>
      <select
        id="jufId"
        name="jufId"
        class="w-full rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-brand-gold focus:outline-none"
      >
        <option value="">Alle juffen</option>
        {((juffen as Profile[] | null) ?? []).map((j) => (
          <option value={j.id}>{j.naam}</option>
        ))}
      </select>
    </div>

    <div>
      <label for="status" class="mb-1 block text-sm font-medium text-slate-700">Status</label>
      <select
        id="status"
        name="status"
        class="w-full rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-brand-gold focus:outline-none"
      >
        <option value="">Alle statussen</option>
        <option value="concept">Concept</option>
        <option value="ingediend">Ingediend</option>
        <option value="goedgekeurd">Goedgekeurd</option>
        <option value="betaald">Betaald</option>
      </select>
    </div>

    <button
      type="submit"
      class="rounded-md bg-brand-red px-4 py-2 text-sm font-medium text-white hover:bg-brand-red-dark"
    >
      Excel downloaden
    </button>
  </form>
</AppShell>
