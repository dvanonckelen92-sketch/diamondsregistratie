---
import { actions } from 'astro:actions';
import AppShell from '../../../components/AppShell.astro';
import type { Profile } from '../../../lib/types';

const supabase = Astro.locals.supabase;
const profile = Astro.locals.profile!;

const { data: juffen } = await supabase.from('profiles').select('*').eq('rol', 'juf').order('naam');

const result = Astro.getActionResult(actions.admin.createJuf);
---

<AppShell title="Juffen" profile={profile}>
  <div class="mb-6 rounded-lg border border-slate-200 bg-white p-4">
    <h2 class="mb-3 text-sm font-semibold text-slate-700">Nieuwe juf uitnodigen</h2>
    <form method="POST" action={actions.admin.createJuf} class="flex flex-wrap items-end gap-3">
      <div>
        <label for="naam" class="mb-1 block text-sm font-medium text-slate-700">Naam</label>
        <input
          id="naam"
          name="naam"
          type="text"
          required
          class="rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-slate-500 focus:outline-none"
        />
      </div>
      <div>
        <label for="email" class="mb-1 block text-sm font-medium text-slate-700">E-mailadres</label>
        <input
          id="email"
          name="email"
          type="email"
          required
          class="rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-slate-500 focus:outline-none"
        />
      </div>
      <button
        type="submit"
        class="rounded-md bg-slate-900 px-4 py-2 text-sm font-medium text-white hover:bg-slate-800"
      >
        Uitnodigen
      </button>
    </form>
    {result?.error && <p class="mt-2 text-sm text-red-600">{result.error.message}</p>}
    {result && !result.error && <p class="mt-2 text-sm text-green-700">Uitnodiging verstuurd.</p>}
  </div>

  <div class="overflow-x-auto rounded-lg border border-slate-200 bg-white">
    <table class="w-full text-sm">
      <thead class="bg-slate-50 text-left text-xs uppercase text-slate-500">
        <tr>
          <th class="px-3 py-2">Naam</th>
          <th class="px-3 py-2">E-mail</th>
          <th class="px-3 py-2"></th>
        </tr>
      </thead>
      <tbody>
        {
          ((juffen as Profile[] | null) ?? []).map((j) => (
            <tr class="border-t border-slate-100">
              <td class="px-3 py-2">{j.naam}</td>
              <td class="px-3 py-2">{j.email}</td>
              <td class="px-3 py-2">
                <a href={`/admin/juffen/${j.id}/tarieven`} class="mr-3 text-slate-600 hover:text-slate-900">
                  Tarieven
                </a>
                <a href={`/admin/juffen/${j.id}/extra`} class="text-slate-600 hover:text-slate-900">
                  Extra vergoedingen
                </a>
              </td>
            </tr>
          ))
        }
        {
          (!juffen || juffen.length === 0) && (
            <tr>
              <td colspan="3" class="px-3 py-6 text-center text-slate-500">
                Nog geen juffen toegevoegd.
              </td>
            </tr>
          )
        }
      </tbody>
    </table>
  </div>
</AppShell>
