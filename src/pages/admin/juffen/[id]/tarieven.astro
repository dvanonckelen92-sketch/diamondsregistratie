---
import { actions } from 'astro:actions';
import AppShell from '../../../../components/AppShell.astro';
import type { Category, Profile, Rate } from '../../../../lib/types';
import { formatDatum, formatEuro } from '../../../../lib/format';

const supabase = Astro.locals.supabase;
const profile = Astro.locals.profile!;
const { id } = Astro.params as { id: string };

const [{ data: juf }, { data: categories }, { data: rates }] = await Promise.all([
  supabase.from('profiles').select('*').eq('id', id).single(),
  supabase.from('categories').select('*').order('naam'),
  supabase.from('rates').select('*').eq('profile_id', id).order('geldig_vanaf', { ascending: false })
]);

if (!juf) {
  return Astro.redirect('/admin/juffen');
}

const categoryList = (categories as Category[] | null) ?? [];
const categoryMap = new Map(categoryList.map((c) => [c.id, c.naam]));
const ratesList = (rates as Rate[] | null) ?? [];
const createResult = Astro.getActionResult(actions.admin.createRate);
const updateResult = Astro.getActionResult(actions.admin.updateRate);
const deleteResult = Astro.getActionResult(actions.admin.deleteRate);
const vandaag = new Date().toISOString().slice(0, 10);

// ratesList is al gesorteerd op geldig_vanaf aflopend, dus de eerste rij per
// categorie met geldig_vanaf <= vandaag is meteen het huidig geldende tarief.
const huidigPerCategorie = new Map<string, Rate>();
for (const r of ratesList) {
  if (r.geldig_vanaf <= vandaag && !huidigPerCategorie.has(r.category_id)) {
    huidigPerCategorie.set(r.category_id, r);
  }
}
---

<AppShell title={`Tarieven · ${(juf as Profile).naam}`} profile={profile}>
  <div class="mb-6 rounded-lg border border-slate-200 bg-white p-4">
    <h2 class="mb-3 text-sm font-semibold text-slate-700">Nieuw tarief toevoegen</h2>
    <form method="POST" action={actions.admin.createRate} class="flex flex-wrap items-end gap-3">
      <input type="hidden" name="profileId" value={id} />
      <div>
        <label for="categoryId" class="mb-1 block text-sm font-medium text-slate-700">Categorie</label>
        <select
          id="categoryId"
          name="categoryId"
          required
          class="rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-brand-gold focus:outline-none"
        >
          {(categories as Category[] | null ?? []).map((c) => (
            <option value={c.id}>{c.naam}</option>
          ))}
        </select>
      </div>
      <div>
        <label for="uurloon" class="mb-1 block text-sm font-medium text-slate-700">Uurloon (€)</label>
        <input
          id="uurloon"
          name="uurloon"
          type="number"
          step="0.01"
          min="0"
          required
          class="rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-brand-gold focus:outline-none"
        />
      </div>
      <div>
        <label for="geldigVanaf" class="mb-1 block text-sm font-medium text-slate-700">Geldig vanaf</label>
        <input
          id="geldigVanaf"
          name="geldigVanaf"
          type="date"
          required
          value={vandaag}
          class="rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-brand-gold focus:outline-none"
        />
      </div>
      <button
        type="submit"
        class="rounded-md bg-brand-red px-4 py-2 text-sm font-medium text-white hover:bg-brand-red-dark"
      >
        Toevoegen
      </button>
    </form>
    {createResult?.error && <p class="mt-2 text-sm text-red-600">{createResult.error.message}</p>}
  </div>

  <h2 class="mb-2 text-sm font-semibold text-slate-700">Huidige tarieven</h2>
  <div class="mb-6 overflow-hidden rounded-lg border border-slate-200 bg-white">
    {
      categoryList.map((c) => {
        const huidig = huidigPerCategorie.get(c.id);
        return (
          <div class="flex items-center justify-between border-b border-slate-100 px-4 py-3 last:border-b-0">
            <span class="text-sm font-medium">{c.naam}</span>
            {huidig ? (
              <span class="text-sm">
                <span class="font-semibold text-brand-gold-dark">{formatEuro(Number(huidig.uurloon))}</span>
                <span class="text-slate-400"> · sinds {formatDatum(huidig.geldig_vanaf)}</span>
              </span>
            ) : (
              <span class="text-sm text-slate-400">Nog geen tarief ingesteld</span>
            )}
          </div>
        );
      })
    }
    {
      categoryList.length === 0 && (
        <p class="px-4 py-6 text-center text-sm text-slate-500">Nog geen categorieën aangemaakt.</p>
      )
    }
  </div>

  <h2 class="mb-2 text-sm font-semibold text-slate-700">Geschiedenis</h2>
  {updateResult?.error && <p class="mb-2 text-sm text-red-600">{updateResult.error.message}</p>}
  {deleteResult?.error && <p class="mb-2 text-sm text-red-600">{deleteResult.error.message}</p>}
  <div class="overflow-x-auto rounded-lg border border-slate-200 bg-white">
    <table class="w-full text-sm">
      <thead class="bg-slate-50 text-left text-xs uppercase text-slate-500">
        <tr>
          <th class="px-3 py-2">Categorie</th>
          <th class="px-3 py-2">Uurloon</th>
          <th class="px-3 py-2">Geldig vanaf</th>
          <th class="px-3 py-2 text-right">Acties</th>
        </tr>
      </thead>
      <tbody>
        {
          ratesList.map((r) => {
            const isHuidig = huidigPerCategorie.get(r.category_id)?.id === r.id;
            const formId = `rate-${r.id}`;
            return (
              <tr class="border-t border-slate-100">
                <td class="px-3 py-2">
                  {categoryMap.get(r.category_id) ?? 'Onbekend'}
                  {isHuidig && (
                    <span class="ml-2 rounded-full border border-brand-gold/40 bg-brand-gold-light px-2 py-0.5 text-xs font-medium text-brand-gold-dark">
                      Actief
                    </span>
                  )}
                </td>
                <td class="px-3 py-2">
                  <input
                    form={formId}
                    name="uurloon"
                    type="number"
                    step="0.01"
                    min="0"
                    required
                    value={r.uurloon}
                    class="w-24 rounded-md border border-slate-300 px-2 py-1.5 text-sm focus:border-brand-gold focus:outline-none"
                  />
                </td>
                <td class="px-3 py-2">
                  <input
                    form={formId}
                    name="geldigVanaf"
                    type="date"
                    required
                    value={r.geldig_vanaf}
                    class="rounded-md border border-slate-300 px-2 py-1.5 text-sm focus:border-brand-gold focus:outline-none"
                  />
                </td>
                <td class="px-3 py-2">
                  <div class="flex justify-end gap-2">
                    <form id={formId} method="POST" action={actions.admin.updateRate}>
                      <input type="hidden" name="id" value={r.id} />
                      <button
                        type="submit"
                        class="rounded-md border border-slate-300 px-2.5 py-1 text-xs font-medium text-slate-600 hover:border-brand-gold hover:text-brand-gold-dark"
                      >
                        Opslaan
                      </button>
                    </form>
                    <form method="POST" action={actions.admin.deleteRate}>
                      <input type="hidden" name="id" value={r.id} />
                      <button
                        type="submit"
                        class="rounded-md border border-red-200 px-2.5 py-1 text-xs font-medium text-red-600 hover:bg-red-50"
                      >
                        Verwijderen
                      </button>
                    </form>
                  </div>
                </td>
              </tr>
            );
          })
        }
        {
          ratesList.length === 0 && (
            <tr>
              <td colspan="4" class="px-3 py-6 text-center text-slate-500">
                Nog geen tarieven ingesteld.
              </td>
            </tr>
          )
        }
      </tbody>
    </table>
  </div>
</AppShell>
