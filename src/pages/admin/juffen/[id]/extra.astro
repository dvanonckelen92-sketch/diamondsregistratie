---
import { actions } from 'astro:actions';
import AppShell from '../../../../components/AppShell.astro';
import type { ExtraPayment, Profile } from '../../../../lib/types';
import { formatDatum, formatEuro } from '../../../../lib/format';

const supabase = Astro.locals.supabase;
const profile = Astro.locals.profile!;
const { id } = Astro.params as { id: string };

const [{ data: juf }, { data: extras }] = await Promise.all([
  supabase.from('profiles').select('*').eq('id', id).single(),
  supabase.from('extra_payments').select('*').eq('profile_id', id).order('datum', { ascending: false })
]);

if (!juf) {
  return Astro.redirect('/admin/juffen');
}

const createResult = Astro.getActionResult(actions.admin.createExtraPayment);
const paidResult = Astro.getActionResult(actions.admin.markExtraPaid);
const vandaag = new Date().toISOString().slice(0, 10);
---

<AppShell title={`Extra vergoedingen · ${(juf as Profile).naam}`} profile={profile}>
  <div class="mb-6 rounded-lg border border-slate-200 bg-white p-4">
    <h2 class="mb-3 text-sm font-semibold text-slate-700">Nieuwe vergoeding toevoegen</h2>
    <form method="POST" action={actions.admin.createExtraPayment} class="flex flex-wrap items-end gap-3">
      <input type="hidden" name="profileId" value={id} />
      <div>
        <label for="omschrijving" class="mb-1 block text-sm font-medium text-slate-700">Omschrijving</label>
        <input
          id="omschrijving"
          name="omschrijving"
          type="text"
          required
          class="rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-brand-gold focus:outline-none"
        />
      </div>
      <div>
        <label for="bedrag" class="mb-1 block text-sm font-medium text-slate-700">Bedrag (€)</label>
        <input
          id="bedrag"
          name="bedrag"
          type="number"
          step="0.01"
          required
          class="rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-brand-gold focus:outline-none"
        />
      </div>
      <div>
        <label for="datum" class="mb-1 block text-sm font-medium text-slate-700">Datum</label>
        <input
          id="datum"
          name="datum"
          type="date"
          required
          value={vandaag}
          class="rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-brand-gold focus:outline-none"
        />
      </div>
      <button
        type="submit"
        class="rounded-md bg-brand-red px-4 py-2 text-sm font-medium text-white hover:bg-brand-red-dark"
      >
        Toevoegen
      </button>
    </form>
    {createResult?.error && <p class="mt-2 text-sm text-red-600">{createResult.error.message}</p>}
    {paidResult?.error && <p class="mt-2 text-sm text-red-600">{paidResult.error.message}</p>}
  </div>

  <div class="overflow-x-auto rounded-lg border border-slate-200 bg-white">
    <table class="w-full text-sm">
      <thead class="bg-slate-50 text-left text-xs uppercase text-slate-500">
        <tr>
          <th class="px-3 py-2">Omschrijving</th>
          <th class="px-3 py-2">Datum</th>
          <th class="px-3 py-2">Bedrag</th>
          <th class="px-3 py-2">Status</th>
          <th class="px-3 py-2"></th>
        </tr>
      </thead>
      <tbody>
        {
          ((extras as ExtraPayment[] | null) ?? []).map((e) => (
            <tr class="border-t border-slate-100">
              <td class="px-3 py-2">{e.omschrijving}</td>
              <td class="px-3 py-2">{formatDatum(e.datum)}</td>
              <td class="px-3 py-2">{formatEuro(Number(e.bedrag))}</td>
              <td class="px-3 py-2">
                <span
                  class:list={[
                    'rounded-full px-2 py-0.5 text-xs font-medium',
                    e.status === 'betaald' ? 'bg-green-100 text-green-800' : 'bg-amber-100 text-amber-800'
                  ]}
                >
                  {e.status === 'betaald' ? 'Betaald' : 'Goedgekeurd'}
                </span>
              </td>
              <td class="px-3 py-2">
                {e.status !== 'betaald' && (
                  <form method="POST" action={actions.admin.markExtraPaid}>
                    <input type="hidden" name="ids" value={e.id} />
                    <button type="submit" class="text-sm text-slate-600 hover:text-slate-900">
                      Markeer betaald
                    </button>
                  </form>
                )}
              </td>
            </tr>
          ))
        }
        {
          (!extras || extras.length === 0) && (
            <tr>
              <td colspan="5" class="px-3 py-6 text-center text-slate-500">
                Nog geen extra vergoedingen.
              </td>
            </tr>
          )
        }
      </tbody>
    </table>
  </div>
</AppShell>
